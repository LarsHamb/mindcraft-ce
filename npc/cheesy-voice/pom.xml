<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>de.cheesy</groupId>
    <artifactId>cheesy-voice</artifactId>
    <version>1.1.0</version>
    <packaging>jar</packaging>

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <repositories>
        <repository>
            <id>henkelmax</id>
            <url>https://maven.maxhenkel.de/repository/public</url>
        </repository>
    </repositories>

    <dependencies>
        <dependency>
            <groupId>de.maxhenkel.voicechat</groupId>
            <artifactId>voicechat-api</artifactId>
            <version>2.6.20</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.json</groupId>
            <artifactId>json</artifactId>
            <version>20231013</version>
        </dependency>
        <dependency>
            <groupId>net.minecraft</groupId>
            <artifactId>server</artifactId>
            <version>26.3</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/../libs/server-26.3.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>net.fabricmc</groupId>
            <artifactId>fabric-loader</artifactId>
            <version>0.20.1</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/../libs/fabric-loader-0.20.1.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>net.fabricmc</groupId>
            <artifactId>sponge-mixin</artifactId>
            <version>0.17.5</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/../libs/sponge-mixin-0.17.5+mixin.0.8.7.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>net.fabricmc</groupId>
            <artifactId>fabric-message-api-v1</artifactId>
            <version>7.1.0</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/../libs/fabric-message-api-v1-7.1.0+3e5b46335d.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>net.fabricmc</groupId>
            <artifactId>fabric-api-base</artifactId>
            <version>2.0.6</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/../libs/fabric-api-base-2.0.6+fcdff87f5d.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>com.mojang</groupId>
            <artifactId>brigadier</artifactId>
            <version>1.3.11</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/../libs/brigadier-1.3.11.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>com.mojang</groupId>
            <artifactId>datafixerupper</artifactId>
            <version>10.0.21</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/../libs/datafixerupper-10.0.21.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>com.mojang</groupId>
            <artifactId>authlib</artifactId>
            <version>10.0.77</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/../libs/authlib-10.0.77.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>lib</groupId>
            <artifactId>logging-1.7.12</artifactId>
            <version>1</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/../libs/logging-1.7.12.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>lib</groupId>
            <artifactId>guava-33.6.0-jre</artifactId>
            <version>1</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/../libs/guava-33.6.0-jre.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>lib</groupId>
            <artifactId>gson-2.14.0</artifactId>
            <version>1</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/../libs/gson-2.14.0.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>lib</groupId>
            <artifactId>joml-1.10.9</artifactId>
            <version>1</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/../libs/joml-1.10.9.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>lib</groupId>
            <artifactId>slf4j-api-2.0.17</artifactId>
            <version>1</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/../libs/slf4j-api-2.0.17.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>lib</groupId>
            <artifactId>jspecify-1.0.0</artifactId>
            <version>1</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/../libs/jspecify-1.0.0.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>lib</groupId>
            <artifactId>netty-common-4.2.16.Final</artifactId>
            <version>1</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/../libs/netty-common-4.2.16.Final.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>lib</groupId>
            <artifactId>netty-transport-4.2.16.Final</artifactId>
            <version>1</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/../libs/netty-transport-4.2.16.Final.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>lib</groupId>
            <artifactId>netty-buffer-4.2.16.Final</artifactId>
            <version>1</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/../libs/netty-buffer-4.2.16.Final.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>lib</groupId>
            <artifactId>fastutil-8.5.18</artifactId>
            <version>1</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/../libs/fastutil-8.5.18.jar</systemPath>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.1</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <relocations>
                                <relocation>
                                    <pattern>org.json</pattern>
                                    <shadedPattern>de.cheesy.shaded.json</shadedPattern>
                                </relocation>
                            </relocations>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
